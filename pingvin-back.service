[Unit]
Description=Pingvin Backend
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=root
Restart=always
RestartSec=5s
LimitNOFILE=524288

# All deployment settings (DATABASE_URL, DATA_DIRECTORY, SITE_NAME, ...) live
# in backend/.env so they survive code updates and are easy to edit.
EnvironmentFile=-/var/www/pingvin_source/backend/.env
Environment=NODE_ENV=production

WorkingDirectory=/var/www/pingvin_source/backend
ExecStart=/usr/bin/npm -- run prod

[Install]
WantedBy=multi-user.target
