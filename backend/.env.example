# Copy this file to .env and adjust the values to customize your instance.
# backend/.env is gitignored. It is read by:
#   1. the backend itself (backend/.env first, then ../.env), and
#   2. the Prisma CLI (migrate deploy / db seed), where it takes precedence
#      over backend/prisma/.env.

# Display name of your instance. Overrides general.appName from the database
# and config.yaml. The repository default is the "SiteName" placeholder.
SITE_NAME=SiteName

# IMPORTANT: set DATABASE_URL to the absolute path of your production database.
# Without it, "prisma migrate deploy" resolves backend/prisma/.env relative to
# the prisma folder (backend/data/...) while the backend falls back to a path
# relative to its working directory, so migrations can silently run against
# the wrong database. The systemd unit pingvin-back.service also exports this
# variable for the `npm run prod` flow.
# DATABASE_URL="file:/var/www/pingvin_data/pingvin-share.db?connection_limit=1"
# DATA_DIRECTORY=/var/www/pingvin_data
# THROTTLE_LIMIT=300
