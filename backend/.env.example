# Copy this file to .env and adjust the values to customize your instance.
# backend/.env is not committed (see .gitignore); update.sh creates it on the
# server and keeps the database path in sync. It is read by:
#   1. the backend itself (backend/.env first, then ../.env), and
#   2. the Prisma CLI (migrate deploy / db seed), where it takes precedence
#      over backend/prisma/.env.

# Optional: display name of your instance. Overrides general.appName from the
# database and config.yaml.
# SITE_NAME=Your Site Name

# Send share report notifications to this address instead of the SMTP sender
# email (smtp.email) configured in the admin UI.
# REPORT_EMAIL=admin@example.com

# Trust the reverse proxy's X-Forwarded-For header (set by the frontend proxy).
TRUST_PROXY=true

# Maximum number of requests per minute per route and IP (existing limiter).
THROTTLE_LIMIT=300

# Global limit per visitor (guests use a signed persistent cookie, signed-in
# users use their account ID, and cookie-less clients fall back to their IP).
# Exceeding the limit blocks the visitor for the configured block duration.
VISITOR_RATE_LIMIT=90
VISITOR_RATE_TTL_MS=60000
VISITOR_RATE_BLOCK_MS=60000

# Optional Valkey/Redis cache. Install and start Valkey first, then uncomment.
# CACHE_REDIS_ENABLED=true
# CACHE_REDIS_URL=redis://127.0.0.1:6379

# Production database and upload directory. The update script enforces the
# same DATABASE_URL so migrations always target the live database.
DATABASE_URL="file:/var/www/pingvin_data/pingvin-share.db?connection_limit=1"
DATA_DIRECTORY="/var/www/pingvin_data"
