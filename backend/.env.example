# Copy this file to .env and adjust the values to customize your instance.
# The backend loads backend/.env first, then ../.env (the repository root).

# Display name of your instance. Overrides general.appName from the database
# and config.yaml. The repository default is the "SiteName" placeholder.
SITE_NAME=SiteName

# Deployment-specific paths and limits (optional; the repository defaults to
# relative paths in ./data). The systemd unit pingvin-back.service sets these.
# DATABASE_URL="file:/var/www/pingvin_data/pingvin-share.db?connection_limit=1"
# DATA_DIRECTORY=/var/www/pingvin_data
# THROTTLE_LIMIT=300
