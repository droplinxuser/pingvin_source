# Copy this file to .env and adjust the values to customize your instance.
# backend/.env is not committed (see .gitignore); update.sh creates it on the
# server and keeps the database path in sync. It is read by:
#   1. the backend itself (backend/.env first, then ../.env), and
#   2. the systemd unit and update.sh, which pass these values to the app and
#      Prisma CLI.
# Prisma CLI loads backend/prisma/.env after backend/.env, so run migrations
# with DATABASE_URL set explicitly to override the development default
# (update.sh does this).

# Optional: display name of your instance. Overrides general.appName from the
# database and config.yaml.
# SITE_NAME=Your Site Name

# Send share report notifications to this address instead of the SMTP sender
# email (smtp.email) configured in the admin UI.
# REPORT_EMAIL=admin@example.com

# Optional VirusTotal malware scanning for completed shares. Leave the key
# empty to disable. The free-tier queue is kept in Valkey when available and
# every API request is spaced 173 seconds apart; images, audio, video and
# plain structured text are not sent to VirusTotal.
# VIRUSTOTAL_API_KEY=
# Optional API base URL (usually only changed for a local test stub).
# VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3

# Trust the reverse proxy's X-Forwarded-For header (set by the frontend proxy).
TRUST_PROXY=true

# Maximum number of requests per minute per route and IP (existing limiter).
THROTTLE_LIMIT=300

# Global limit per client: client IP + browser User-Agent. No visitor cookie is
# issued; only a SHA-256 hash of the identifier is stored in Valkey when the
# cache is enabled. Exceeding the limit blocks the client for the configured
# block duration.
VISITOR_RATE_LIMIT=90
VISITOR_RATE_TTL_MS=60000
VISITOR_RATE_BLOCK_MS=60000

# Optional Valkey/Redis cache, shared rate-limit buckets, and 60-minute
# page-view/top-country counters. Without it these fall back to process memory.
# Install and start Valkey first, then uncomment.
# CACHE_REDIS_ENABLED=true
# CACHE_REDIS_URL=redis://127.0.0.1:6379

# Production database and upload directory. The update script enforces the
# same DATABASE_URL so migrations always target the live database.
DATABASE_URL="file:/var/www/pingvin_data/pingvin-share.db?connection_limit=1"
DATA_DIRECTORY="/var/www/pingvin_data"
