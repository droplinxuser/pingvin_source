# Copy this file to .env and adjust the values to customize your instance.
# backend/.env is not committed (see .gitignore); update.sh creates a minimal
# one on the server if it is missing. It is read by:
#   1. the backend itself (backend/.env first, then ../.env), and
#   2. the Prisma CLI (migrate deploy / db seed), where it takes precedence
#      over backend/prisma/.env.

# Display name of your instance. Overrides general.appName from the database
# and config.yaml.
SITE_NAME=SiteName

# Optional: send share report notifications to this address instead of the
# SMTP sender email (smtp.email) configured in the admin UI.
# REPORT_EMAIL=admin@example.com

# IMPORTANT: DATABASE_URL must point at your production database so that
# "prisma migrate deploy" (which runs on every backend restart) always targets
# the right path, even when run outside the systemd unit. The systemd unit
# pingvin-back.service exports the same variables.
# DATABASE_URL="file:/var/www/pingvin_data/pingvin-share.db?connection_limit=1"
# DATA_DIRECTORY=/var/www/pingvin_data
# THROTTLE_LIMIT=300
