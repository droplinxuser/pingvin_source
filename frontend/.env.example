# Copy this file to .env to customize your instance. It is read during
# `npm run build`.
# The PWA manifest at /manifest.json is served dynamically at runtime using
# the site name configured on the backend (general.appName, overridable via
# SITE_NAME in the backend environment).
# API_URL: base URL of the backend API used by server-side code (the dynamic
# manifest fetches the site name from it). Defaults to http://localhost:8080.
# API_URL=http://localhost:8080
