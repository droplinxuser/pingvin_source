# Copy this file to .env and adjust the values to customize your instance.
# The frontend reads .env from this directory when building (npm run build).

# Display name of your instance. Used for the PWA manifest at build time.
# Resolution order during `npm run build`:
#   1. the SITE_NAME environment variable (this file or the shell),
#   2. Environment=SITE_NAME=... in /etc/systemd/system/pingvin-back.service
#      (override the path with the PINGVIN_SERVICE_FILE environment variable),
#   3. the "Pingvin Share" fallback.
# SITE_NAME=My Instance
